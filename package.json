{
  "name": "mps-audio-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "MPS_DEV_ENDPOINTS=1 node --disable-warning=ExperimentalWarning server/index.js",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check": "npm run lint && npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "vitest run",
    "scan:artifacts": "node scripts/scan-artifacts.js",
    "crosscheck:analysis": "node scripts/crosscheck-ffmpeg.js",
    "characterize:chain": "node scripts/characterize-chain.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
